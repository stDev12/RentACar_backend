CREATE DATABASE CarRental

CREATE TABLE Roles
(
	RoleID INT IDENTITY(1,1) PRIMARY KEY,
	RoleName NVARCHAR(15) UNIQUE NOT NULL
)

CREATE TABLE Users 
(
	UserID UNIQUEIDENTIFIER PRIMARY KEY, 
	UserName NVARCHAR(30) NOT NULL, 
	IDNumber NVARCHAR(9) UNIQUE NOT NULL, 
	Email NVARCHAR(50) NOT NULL, 
	PhoneNumber NVARCHAR(20) NOT NULL, 
	UserPassword NVARCHAR(100) NOT NULL, 
	LicenseNumber NVARCHAR(7) NOT NULL, 
	Age INT NOT NULL CHECK (Age > 18), 
	CreatedAT DATETIME NOT NULL DEFAULT GETDATE(),
	RoleID INT FOREIGN KEY REFERENCES Roles(RoleID) NOT NULL, 
)

CREATE TABLE Tokens 
(
	TokenID UNIQUEIDENTIFIER PRIMARY KEY, 
	UserID UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Users(UserID) NOT NULL, 
	TokenJWT NVARCHAR(500) NOT NULL, 
	ExpiryDate DATETIME NOT NULL
)

CREATE TABLE Categories
( 
	CategoryID INT IDENTITY(1,1) PRIMARY KEY, 
	CategoryName NVARCHAR(15) UNIQUE NOT NULL
) 

CREATE TABLE Cars 
( 
	CarID INT IDENTITY(101,1) PRIMARY KEY, 
	CarName NVARCHAR(50) UNIQUE NOT NULL, 
	CategoryID INT FOREIGN KEY REFERENCES Categories (CategoryID), 
	CarType NVARCHAR(10), 
	NumberOfPlaces INT, 
	Rating NUMERIC(3,2) CHECK (Rating BETWEEN 0 AND 5), 
	Price INT NOT NULL, 
	Info NVARCHAR(500), 
	ImagePath NVARCHAR(100) NOT NULL 
)

CREATE TABLE Extras 
( 
	ExtraID INT IDENTITY(1,1) PRIMARY KEY, 
	ExtraName NVARCHAR(30) NOT NULL, 
	Price DECIMAL(5,2) NOT NULL 
)

CREATE TABLE ShoppingCart 
( 
	CartItemID INT IDENTITY(1,1) PRIMARY KEY,   
	UserID UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Users(UserID) NOT NULL, 
	CarID INT FOREIGN KEY REFERENCES Cars(CarID) NOT NULL, 
	Quantity INT NOT NULL 
)

CREATE TABLE CartExtras 
( 
	CartItemID INT REFERENCES ShoppingCart (CartItemID), 
	ExtraID INT REFERENCES Extras (ExtraID), 
	CONSTRAINT PK_CartExtras PRIMARY KEY (CartItemID, ExtraID) 
) 

CREATE TABLE Orders 
( 
	OrderID INT IDENTITY(12345,1) PRIMARY KEY, 
	OrderDate DATETIME NOT NULL, 
	UserID UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Users(UserID) NOT NULL, 
	TotalAmount DECIMAL(10,2) NOT NULL 
)

CREATE TABLE Rentals 
( 
	RentalID INT IDENTITY(1,1) PRIMARY KEY, 
	CarID INT FOREIGN KEY REFERENCES Cars(CarID) NOT NULL,
	CountDays INT NOT NULL, 
)

CREATE TABLE OrderRentals 
( 
	OrderID INT REFERENCES Orders (OrderID) ON DELETE CASCADE, 
	RentalID INT REFERENCES Rentals (RentalID) ON DELETE CASCADE, 
	CONSTRAINT PK_OrderRentals PRIMARY KEY (OrderID, RentalID) 
)

CREATE TABLE RentalExtras 
( 
	RentalID INT REFERENCES Rentals (RentalID), 
	ExtraID INT REFERENCES Extras (ExtraID), 
	CONSTRAINT PK_RentalExtras PRIMARY KEY (RentalID, ExtraID) 
)

